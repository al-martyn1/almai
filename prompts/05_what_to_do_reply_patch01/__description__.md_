                  const std::string& button = "left",
                  int clickCount = 1,
                  int modifiers = 0);
    void cdtDoubleClick(double x, double y, int modifiers = 0);
    void cdtMouseDown(double x, double y, const std::string& button = "left", int modifiers = 0);
